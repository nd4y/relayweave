{
  "uid": "rw-subscriptions",
  "title": "RelayWeave / Subscriptions and control",
  "tags": [
    "relayweave"
  ],
  "timezone": "browser",
  "schemaVersion": 41,
  "version": 1,
  "refresh": "15s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Last successful refresh age",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "relayweave-prometheus"
      },
      "targets": [
        {
          "expr": "time()-proxy_subscription_last_success_timestamp_seconds",
          "refId": "A",
          "legendFormat": "{{route}}{{core}}{{worker}}{{direction}}{{job}}{{kind}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 2,
      "title": "Sources",
      "type": "timeseries",
