{
  "uid": "rw-udp-logs",
  "title": "RelayWeave / UDP and logs",
  "tags": [
    "relayweave"
  ],
  "timezone": "browser",
  "schemaVersion": 41,
  "version": 1,
  "refresh": "15s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "UDP associations",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "relayweave-prometheus"
      },
      "targets": [
        {
          "expr": "proxy_udp_associations_active",
          "refId": "A",
          "legendFormat": "{{route}}{{core}}{{worker}}{{direction}}{{job}}{{kind}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 2,
      "title": "UDP packets",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "relayweave-prometheus"
      },
      "targets": [
        {
          "expr": "rate(proxy_udp_packets_total[2m])",
          "refId": "A",
          "legendFormat": "{{route}}{{core}}{{worker}}{{direction}}{{job}}{{kind}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "pps",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 3,
      "title": "UDP drops",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "relayweave-prometheus"
      },
      "targets": [
        {
          "expr": "rate(proxy_udp_drops_total[2m])",
          "refId": "A",
          "legendFormat": "{{route}}{{core}}{{worker}}{{direction}}{{job}}{{kind}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "pps",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 4,
      "title": "UDP packet counter",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "relayweave-prometheus"
      },
      "targets": [
        {
          "expr": "proxy_udp_packets_total",
          "refId": "A",
          "legendFormat": "{{route}}{{core}}{{worker}}{{direction}}{{job}}{{kind}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 99,
      "title": "Structured application logs (credentials and destinations omitted)",
      "type": "logs",
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 24,
        "h": 12
      },
      "datasource": {
        "type": "loki",
        "uid": "relayweave-loki"
      },
      "targets": [
        {
          "expr": "{app=\"relayweave\"}",
          "refId": "A"
        }
      ],
      "options": {
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": true
      }
    }
  ],
  "editable": false,
  "annotations": {
    "list": []
  },
  "links": [
    {
      "title": "RelayWeave",
      "url": "/",
      "type": "link"
    }
  ]
}
