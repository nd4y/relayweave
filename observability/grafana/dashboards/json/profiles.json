        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "relayweave-prometheus"
      },
      "targets": [
        {
          "expr": "rate(proxy_traffic_bytes_total[2m])*8",
