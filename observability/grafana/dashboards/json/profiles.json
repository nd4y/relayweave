{
  "uid": "rw-profiles",
  "title": "RelayWeave / Profiles and policies",
  "tags": [
    "relayweave"
  ],
  "timezone": "browser",
  "schemaVersion": 41,
  "version": 1,
  "refresh": "15s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Connect latency EWMA",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "relayweave-prometheus"
      },
      "targets": [
        {
          "expr": "proxy_route_rtt_seconds",
          "refId": "A",
          "legendFormat": "{{route}}{{core}}{{worker}}{{direction}}{{job}}{{kind}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 2,
      "title": "Connections by profile",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "relayweave-prometheus"
      },
      "targets": [
        {
          "expr": "rate(proxy_route_connections_total[2m])",
          "refId": "A",
          "legendFormat": "{{route}}{{core}}{{worker}}{{direction}}{{job}}{{kind}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 3,
      "title": "Failures by profile",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "relayweave-prometheus"
      },
      "targets": [
        {
          "expr": "rate(proxy_route_failures_total[2m])",
