# Generate independent long random values. Use letters and digits for DATABASE_PASSWORD.
ADMIN_PASSWORD=replace-with-at-least-24-random-characters
DATABASE_PASSWORD=replace-with-independent-random-password
DATA_ROOT=./data
BIND_IP=127.0.0.1
PROXY_ADVERTISE_IP=127.0.0.1
UI_PORT=18443
HTTP_PORT=18080
SOCKS_PORT=11080
HTTP_AUTH_PORT=18081
SOCKS_AUTH_PORT=11081
COOKIE_SECURE=false
WORKER_CPUS=4
GRAFANA_URL=

# Optional Loki push endpoint. Leave empty for Docker logs only.
LOKI_URL=
