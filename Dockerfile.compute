FROM --platform=$BUILDPLATFORM golang:1.27.2-bookworm@sha256:5cf287a799e6b94384bad13d16b14904c531f51ba65792237e122ce42b392f61 AS build
ARG TARGETARCH
WORKDIR /src
ENV GOMAXPROCS=1 GOFLAGS=-p=1 GOMEMLIMIT=384MiB
COPY go.mod go.sum ./
RUN go mod download
COPY cmd ./cmd
COPY internal ./internal
RUN --mount=type=cache,id=relayweave-compute-go-build,target=/root/.cache/go-build,sharing=locked CGO_ENABLED=0 GOOS=linux GOARCH=$TARGETARCH go build -trimpath -ldflags='-s -w' -o /out/compute-worker ./cmd/compute-worker
RUN --mount=type=cache,id=relayweave-compute-go-build,target=/root/.cache/go-build,sharing=locked CGO_ENABLED=0 GOOS=linux GOARCH=$TARGETARCH go build -trimpath -ldflags='-s -w' -o /out/compute-admin ./cmd/compute-admin

FROM gcr.io/distroless/static-debian12:nonroot@sha256:afa5c872c891853ca7fcf1f12c3edb23f7eeef36189728842dd51042ff57f7ab
COPY --from=build /out/compute-worker /app/compute-worker
COPY --from=build /out/compute-admin /app/compute-admin
USER 65532:65532
ENTRYPOINT ["/app/compute-worker"]
